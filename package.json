{
  "name": "modern-jianpu-markup",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.10.3",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./parser": {
      "types": "./dist/parser/index.d.ts",
      "import": "./dist/parser/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./player": {
      "types": "./dist/player/index.d.ts",
      "import": "./dist/player/index.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "import": "./dist/backend/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "jianpu": "./dist/cli/main.js"
  },
  "files": [
    "dist/",
    "dist-web/",
    "docs/",
    "docs-site/AGENTS.md",
    "docs-site/astro.config.mjs",
    "docs-site/docs/",
    "docs-site/package.json",
    "docs-site/public/",
    "docs-site/src/",
    "examples/",
    "README.md",
    "AGENTS.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "test:coverage": "pnpm run build && c8 --exclude-after-remap --exclude='dist/**' --exclude='dist-web/**' --exclude='src/player/webaudio-tinysynth.js' --exclude='tests/**' --reporter=none node --test tests/backend.test.mjs tests/examples.test.mjs tests/package.test.mjs tests/parser.test.mjs tests/player.test.mjs tests/renderer.test.mjs && c8 report --exclude-after-remap --exclude='dist/**' --exclude='dist-web/**' --exclude='src/player/webaudio-tinysynth.js' --exclude='tests/**' --reporter=text --reporter=html",
    "cli": "pnpm run build && node dist/cli/main.js",
    "dev": "vite",
    "web:app": "vite build",
    "web:build": "pnpm run web:app && pnpm run docs:build",
    "docs:dev": "pnpm -C docs-site dev",
    "docs:build": "pnpm -C docs-site build",
    "docs:check": "pnpm run docs:i18n && pnpm run docs:links && pnpm run docs:tables && pnpm run docs:cli && pnpm -C docs-site check",
    "docs:verify": "pnpm run docs:check && pnpm run docs:examples && pnpm run docs:build",
    "docs:i18n": "node scripts/check-docs-i18n.mjs",
    "docs:examples": "pnpm run build && node scripts/check-doc-examples.mjs",
    "docs:links": "node scripts/check-doc-links.mjs",
    "docs:tables": "node scripts/check-doc-table-pipes.mjs",
    "docs:cli": "node scripts/check-doc-cli-commands.mjs",
    "grammar:railroad": "node scripts/generate-grammar-railroad.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/svg-to-pdfkit": "^0.1.4",
    "@vitejs/plugin-react": "^6.0.1",
    "c8": "^11.0.0",
    "ebnf2railroad": "^1.14.2",
    "typescript": "^5.8.3",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@descript/web-audio-js": "0.15.3-patched.6",
    "@expo-google-fonts/noto-sans-sc": "^0.4.3",
    "@resvg/resvg-js": "^2.6.2",
    "@vexflow-fonts/bravura": "1.0.2",
    "jspdf": "^4.2.1",
    "lamejs": "^1.2.1",
    "pdfkit": "^0.19.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "svg-to-pdfkit": "^0.1.8",
    "svg2pdf.js": "^2.7.0"
  }
}
