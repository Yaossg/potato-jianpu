{
  "name": "modern-jianpu-markup",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.10.3",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./parser": {
      "types": "./dist/parser/index.d.ts",
      "import": "./dist/parser/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./player": {
      "types": "./dist/player/index.d.ts",
      "import": "./dist/player/index.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "import": "./dist/backend/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "jianpu": "./dist/cli/main.js"
  },
  "files": [
    "dist/",
    "dist-web/",
    "docs/",
    "examples/",
    "README.md",
    "AGENTS.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "cli": "pnpm run build && node dist/cli/main.js",
    "dev": "vite",
    "web:build": "vite build",
    "grammar:railroad": "node scripts/generate-grammar-railroad.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "ebnf2railroad": "^1.14.2",
    "typescript": "^5.8.3",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@descript/web-audio-js": "0.15.3-patched.6",
    "@resvg/resvg-js": "^2.6.2",
    "lamejs": "^1.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
