file = { NEWLINE }, [ header ], [ score ], EOF ;

header = { property }, EQUALS, { EQUALS }, NEWLINE, { NEWLINE } ;
property = property_label, STRING, NEWLINE, { NEWLINE } ;

property_label = IDENTIFIER, ":" ;
track_label = TRACK_LABEL, ":" ;

score = line, { NEWLINE, { NEWLINE }, line }, { NEWLINE } ;

line = [ track_label ], [ start_barline ], [ ending ], measure, { measure_separator, [ ending ], measure }, [ end_barline ] ;

start_barline = BAR | REPEAT_START ;
measure_separator = BAR | REPEAT_START | REPEAT_BOTH ;
end_barline = BAR | REPEAT_END ;

ending = "[", NOTE, "]" ;

measure = [ octave ], durable_note, { durable_note } ;
octave = LOWER, { LOWER } | HIGHER, { HIGHER } ;

durable_note = [ tie ], general_note, [ length ] ;
tie = TIE ;

general_note = chord | rest | drum ;
chord = pitch_note | "{", pitch_note, { pitch_note }, "}" ;

pitch_note = [ accidental ], NOTE, [ octave ] ;
accidental = SHARPSHARP | SHARP | FLATFLAT | FLAT | NATURAL ;

rest = REST ;
drum = DRUM ;

length = DASH, { DASH } | ( HALF | DOT ), { HALF | DOT } ;

skipped = WS | COMMENT ;

IDENTIFIER = "[A-Za-z_]+, or T followed by digits when followed by ':'" ;
TRACK_LABEL = "T1" | "T2" | "T3" | "T4" | "T5" | "T6" | "T7" | "T8" | "T9" | "T11" | "T12" | "T13" | "T14" | "T15" | "T16" ;
STRING = "quoted string" ;
NOTE = "1" | "2" | "3" | "4" | "5" | "6" | "7" ;
REST = "0" ;
DRUM = "X" ;
BAR = "|" ;
REPEAT_START = "|:" ;
REPEAT_END = ":|" ;
REPEAT_BOTH = ":|:" ;
LBRACKET = "[" ;
RBRACKET = "]" ;
SHARPSHARP = "##" ;
SHARP = "#" ;
FLATFLAT = "bb" ;
FLAT = "b" ;
NATURAL = "%" ;
HALF = "/" ;
DOT = "." ;
DASH = "-" ;
LOWER = "," ;
HIGHER = "'" ;
TIE = "~" ;
EQUALS = "=" ;
NEWLINE = "\n" | "\r\n" | "\r" ;
WS = "space or tab" ;
COMMENT = "comment" ;
EOF = "end of file" ;
