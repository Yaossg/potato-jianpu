---
const {
  title,
  features = [],
  columns,
  featureLabel,
  yesLabel,
  noLabel,
  unknownLabel = "-",
} = Astro.props;
const isChinesePage = Astro.url.pathname.includes("/zh/");
const resolvedColumns = columns ?? [
  ["parser", isChinesePage ? "解析器" : "Parser"],
  ["image", isChinesePage ? "图像" : "Image"],
  ["playback", isChinesePage ? "播放" : "Playback"],
  ["export", isChinesePage ? "导出" : "Export"],
  ["cli", "CLI"],
];
const resolvedFeatureLabel = featureLabel ?? (isChinesePage ? "功能" : "Feature");
const resolvedYesLabel = yesLabel ?? "✔️";
const resolvedNoLabel = noLabel ?? "❌";

function supportLabel(value) {
  if (value === true) return resolvedYesLabel;
  if (value === false) return resolvedNoLabel;
  return value === undefined ? unknownLabel : value;
}
---

<section class="support-matrix">
  {title && <h2>{title}</h2>}
  <table>
    <thead>
      <tr>
        <th>{resolvedFeatureLabel}</th>
        {resolvedColumns.map(([, label]) => <th>{label}</th>)}
      </tr>
    </thead>
    <tbody>
      {features.map((feature) => (
        <tr>
          <th scope="row">{feature.feature}</th>
          {resolvedColumns.map(([key]) => <td>{supportLabel(feature[key])}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</section>

<style>
  .support-matrix {
    margin: 2rem 0;
  }

  .support-matrix h2 {
    margin-bottom: 0.75rem;
  }

  .support-matrix table {
    display: table;
    width: 100%;
  }
</style>
