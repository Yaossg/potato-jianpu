---
const {
  title = "Support",
  features = [],
  columns = [
    ["parser", "Parser"],
    ["render", "SVG"],
    ["playback", "Playback"],
    ["export", "Export"],
    ["cli", "CLI"],
  ],
  featureLabel,
  yesLabel,
  noLabel,
  unknownLabel = "-",
} = Astro.props;
const isChinesePage = Astro.url.pathname.includes("/zh/");
const resolvedFeatureLabel = featureLabel ?? (isChinesePage ? "功能" : "Feature");
const resolvedYesLabel = yesLabel ?? (isChinesePage ? "是" : "Yes");
const resolvedNoLabel = noLabel ?? (isChinesePage ? "否" : "No");

function supportLabel(value) {
  if (value === true) return resolvedYesLabel;
  if (value === false) return resolvedNoLabel;
  return value === undefined ? unknownLabel : value;
}
---

<section class="support-matrix">
  <h2>{title}</h2>
  <table>
    <thead>
      <tr>
        <th>{resolvedFeatureLabel}</th>
        {columns.map(([, label]) => <th>{label}</th>)}
      </tr>
    </thead>
    <tbody>
      {features.map((feature) => (
        <tr>
          <th scope="row">{feature.feature}</th>
          {columns.map(([key]) => <td>{supportLabel(feature[key])}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</section>

<style>
  .support-matrix {
    margin: 2rem 0;
  }

  .support-matrix h2 {
    margin-bottom: 0.75rem;
  }

  .support-matrix table {
    display: table;
    width: 100%;
  }
</style>
