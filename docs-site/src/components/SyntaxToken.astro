---
interface Props {
  token: string;
  label?: string;
}

const { token, label } = Astro.props;
---

<code class="syntax-token" title={label}>{token}</code>

<style>
  .syntax-token {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    padding: 0.05rem 0.3rem;
    background: var(--sl-color-gray-6);
    white-space: nowrap;
  }
</style>
